# Copier en .env et remplir. Ne jamais committer .env.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres local (docker-compose). Pointer plus tard vers la chaîne de
# connexion Supabase (Settings > Database > Connection string > URI) sans
# rien changer côté code : Supabase expose du Postgres standard.
# ex. Supabase : postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgres://zener:zener@db:5432/zener

# Origine(s) autorisée(s) à appeler l'API depuis le navigateur (Vite dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
